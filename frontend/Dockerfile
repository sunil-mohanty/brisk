FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# /api rewrites are compiled into the build, so the API address is a build argument.
ARG API_URL=http://api:8000
ENV API_URL=$API_URL NEXT_TELEMETRY_DISABLED=1
# Website + ad settings (lib/site.ts). Railway passes service Variables in as build args.
ARG NEXT_PUBLIC_SUPPORT_WHATSAPP NEXT_PUBLIC_CONTACT_EMAIL NEXT_PUBLIC_PRICE_AED NEXT_PUBLIC_TRIAL_DAYS \
    NEXT_PUBLIC_DEMO_YOUTUBE_ID NEXT_PUBLIC_GOOGLE_ADS_ID NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL \
    NEXT_PUBLIC_GA4_ID NEXT_PUBLIC_META_PIXEL_ID NEXT_PUBLIC_OPERATOR NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_BRAND_NAME
ENV NEXT_PUBLIC_SUPPORT_WHATSAPP=$NEXT_PUBLIC_SUPPORT_WHATSAPP NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL \
    NEXT_PUBLIC_PRICE_AED=$NEXT_PUBLIC_PRICE_AED NEXT_PUBLIC_TRIAL_DAYS=$NEXT_PUBLIC_TRIAL_DAYS \
    NEXT_PUBLIC_DEMO_YOUTUBE_ID=$NEXT_PUBLIC_DEMO_YOUTUBE_ID NEXT_PUBLIC_GOOGLE_ADS_ID=$NEXT_PUBLIC_GOOGLE_ADS_ID \
    NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=$NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL NEXT_PUBLIC_GA4_ID=$NEXT_PUBLIC_GA4_ID \
    NEXT_PUBLIC_META_PIXEL_ID=$NEXT_PUBLIC_META_PIXEL_ID NEXT_PUBLIC_OPERATOR=$NEXT_PUBLIC_OPERATOR \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_BRAND_NAME=$NEXT_PUBLIC_BRAND_NAME
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
