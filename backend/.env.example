DATABASE_URL=postgresql+psycopg://salon:salon@localhost:5432/salon
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
# Product name used in emails and messages.
BRAND_NAME=Tressa
# Public URL of the Next.js app. Link pages, confirmations, quote links and QR codes point here.
APP_URL=http://localhost:3000
# Production: APP_URL=https://yourdomain.com
CORS_ORIGINS=http://localhost:3000
# Optional older shared invite code. Still accepted if typed; not required.
SIGNUP_CODE=
# Password reset emails (Resend). Without a key, reset links are written to the API log.
RESEND_API_KEY=
EMAIL_FROM=Tressa <no-reply@yourdomain.com>
# Emails that can open /admin (comma-separated). Use the email you sign in with.
ADMIN_EMAILS=
# Anyone can sign up from the website and gets a free trial. false = invite codes required.
OPEN_SIGNUP=true
SIGNUP_TRIAL_DAYS=14
SIGNUP_PLAN=Starter
# Monthly price (AED) recorded on new self-serve accounts, for your admin revenue view. Optional.
SIGNUP_PLAN_AMOUNT=
